# SignalForge example environment. Copy to .env and fill in secrets locally.
# Never commit .env. This file contains no secrets.

# Demo mode uses public Luno market data and a simulated ZAR wallet.
# It does not place exchange orders. Set to 0 only after you intend to allow live trading.
SIGNALFORGE_DEMO=1

# Engine bind address. Non-loopback binds require SIGNALFORGE_ACCESS_TOKEN.
# The Android app is not a loopback client. To use it, bind a reachable address
# and set a long random token. The phone stores that token in encrypted storage.
# SIGNALFORGE_BIND=0.0.0.0
SIGNALFORGE_BIND=127.0.0.1
SIGNALFORGE_PORT=8787
SIGNALFORGE_DB=./data/signalforge.sqlite

# Required when the engine or web UI is reachable beyond localhost.
# SIGNALFORGE_ACCESS_TOKEN=

# Luno API key. Create a key with ONLY:
#   View balance (Perm_R_Balance = 1)
#   View orders (Perm_R_Orders = 32)
#   Create orders (Perm_W_Orders = 64)
# Combined bitmask = 97.
# Do not enable send, withdrawal, beneficiary, or debit permissions.
# Withdrawals are not implemented and must stay disabled on the key.
# LUNO_API_KEY_ID=
# LUNO_API_KEY_SECRET=
LUNO_API_BASE=https://api.luno.com
LUNO_WS_BASE=wss://ws.luno.com

# xAI API. Grok is an analysis service only. It never receives these exchange keys.
# XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Priced chat model from https://docs.x.ai/developers/models
# grok-4.6 is the documented flagship. grok-4.3 is the cheaper documented alternative.
XAI_MODEL=grok-4.6

# Analysis is not run on every price tick.
ANALYSIS_INTERVAL_MS=900000
ANALYSIS_MOVE_BPS=50

# Paper wallet and matching.
PAPER_SEED_ZAR=100000
PAPER_DELAY_MS=300

# Web server. ENGINE_INTERNAL_URL is read by the Next.js server, not the browser.
ENGINE_INTERNAL_URL=http://127.0.0.1:8787
WEB_PORT=3000
